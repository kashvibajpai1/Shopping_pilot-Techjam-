# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The pipeline runs fully offline with none of these set — see README.md
# "Model & network policy" before enabling any of them for real grading.

# --- Catalog integrity -------------------------------------------------
# Organizer-published SHA256 for catalog.jsonl. If unset, checksum
# verification is skipped (loudly logged, never silently).
TECHJAM_CATALOG_SHA256=

# --- Optional dense-embedding upgrade -----------------------------------
# 1 = use sentence-transformers/all-MiniLM-L6-v2 instead of the default
# offline hash embedder. Requires the `sentence-transformers` extra and,
# the first time, network access to download model weights.
TECHJAM_USE_SENTENCE_TRANSFORMERS=0

# --- Optional LLM semantic reranker / ambiguous-intent escalation ------
# 1 = enable the LLM reranker and the intent router's ambiguous-case
# escalation. Requires TECHJAM_LLM_PROVIDER's API key and network access.
# With this unset (default), the pipeline uses the deterministic,
# offline HeuristicReranker and never makes a network call.
TECHJAM_ENABLE_LLM=0
TECHJAM_LLM_PROVIDER=anthropic
TECHJAM_LLM_MODEL=claude-haiku-4-5-20251001
TECHJAM_LLM_TIMEOUT_SECONDS=6

# Required only if TECHJAM_ENABLE_LLM=1 and TECHJAM_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
